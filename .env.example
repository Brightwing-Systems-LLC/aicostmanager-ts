# AI Cost Manager API key
AICM_API_KEY=your-api-key-here

# Optional: override base URL (default: https://aicostmanager.com)
# AICM_API_BASE=https://aicostmanager.com

# Optional: override API path (default: /api/v1)
# AICM_API_URL=/api/v1

# Optional: raise errors instead of returning error objects (default: false)
# AICM_RAISE_ON_ERROR=false
